# Build output from the reference scripts in python/ and from downloaded
# Builder scripts. rules.md is explicit that these are artifacts, not sources:
# "the generated PNGs and .txt reports are build output — don't commit them".
*_rf_adc.png
*_gradients.png
*_kspace.png
*_report.txt

# Sequences produced by running the scripts. The one under examples/ is a
# deliberate specimen and is committed; anything else is output.
*.seq
!examples/*.seq

# Python
__pycache__/
*.py[cod]

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
dist/
